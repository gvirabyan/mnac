rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Push history. Apps may read only what has actually been sent — a
    // scheduled push stays hidden until it goes out. "sent" went to
    // everyone, "sent_<language>" to one language. Nothing writes from a
    // client; the Cloud Function and the console use admin access.
    match /announcements/{id} {
      allow read: if resource.data.status in ['sent', 'sent_hy', 'sent_ru', 'sent_en'];
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
