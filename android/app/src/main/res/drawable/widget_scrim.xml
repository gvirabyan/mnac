<?xml version="1.0" encoding="utf-8"?>
<!-- Readability scrim over the widget's background photo, mirroring the
     gradient the iOS extension draws and the one HomeBackground uses in the
     app. Shown only when a photo is behind the text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#59000000"
        android:endColor="#A6000000" />
</shape>
